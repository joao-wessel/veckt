# Copie para .env e substitua todos os valores antes de iniciar o ambiente.
POSTGRES_DB=vectk
POSTGRES_USER=vectk
POSTGRES_PASSWORD=generate-a-long-unique-database-password

# Gere valores independentes com pelo menos 32 caracteres aleatórios.
VECTK_PLATFORM_JWT_SECRET=generate-a-unique-platform-jwt-secret-with-32-chars
VECTK_TENANT_JWT_SECRET=generate-a-unique-tenant-jwt-secret-with-32-chars
VECTK_JWT_ISSUER=vectk
VECTK_ACCESS_TOKEN_MINUTES=30

# Origens separadas por vírgula; nunca utilize * em produção.
APP_ALLOWED_ORIGINS=https://app.example.com
APP_PUBLIC_WEBSITE_URL=https://app.example.com
APP_PUBLIC_FRONTEND_URL=https://app.example.com
# A API é publicada pelo mesmo domínio através de /api.
APP_PUBLIC_BACKEND_URL=https://app.example.com
FRONTEND_PORT=4200
BACKEND_PORT=8080
POSTGRES_PORT=5432

# Staging em VPS: o proxy é o único serviço exposto (portas 80 e 443).
APP_DOMAIN=staging.example.com
LETSENCRYPT_EMAIL=infra@example.com
HTTP_PORT=80
HTTPS_PORT=443
VECTK_VOLUME_PREFIX=vectk_staging
APP_TIMEZONE=America/Sao_Paulo
APP_STORAGE_PATH=/app/storage
VECTK_MAX_FILE_SIZE=104857600B
VECTK_MAX_REQUEST_SIZE=524288000B
# Os valores acima equivalem a 100 MiB e 500 MiB. O Nginx usa sua notação própria.
NGINX_CLIENT_MAX_BODY_SIZE=500m

# Operação de backup. VECTK_BACKUP_REMOTE é opcional e usado apenas por copy-backup.sh.
VECTK_BACKUP_DIR=/opt/vectk/backups
VECTK_BACKUP_MIN_FREE_KB=1048576
VECTK_BACKUP_MAX_AGE_HOURS=26
VECTK_BACKUP_REMOTE=
# Opcional: necessário apenas quando houver mais de uma composição Vectk na mesma máquina.
VECTK_COMPOSE_PROJECT=vectk
# Usada apenas pelos scripts de backup/restauração ao operar a composição HTTPS.
VECTK_STAGING_HTTPS=true

# Bootstrap opcional do primeiro administrador de plataforma. Não cria Tenant.
# Preencha apenas na primeira subida de um banco vazio, depois desative e reinicie o backend.
VECTK_INITIAL_BOOTSTRAP_ENABLED=false
VECTK_INITIAL_ADMIN_NAME=
VECTK_INITIAL_ADMIN_EMAIL=
VECTK_INITIAL_ADMIN_PASSWORD=

# SMTP é opcional e deve ser configurado com credenciais reais fora do repositório.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
